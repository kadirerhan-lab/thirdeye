{
  "name": "thirdeye",
  "version": "0.1.0",
  "private": true,
  "description": "ThirdEye: tiroid ultrason nodül analizi ve öğrenen risk skorlaması prototipi",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "stanford:inspect": "python tools/stanford/extract.py --inspect --hdf5",
    "stanford:prepare": "node tools/stanford/prepare.mjs --data data/stanford",
    "stanford:train": "python tools/stanford/train_torch.py --data data/stanford",
    "stanford:finalize": "node tools/stanford/finalize.mjs --data data/stanford"
  },
  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^23.11.1"
  }
}
